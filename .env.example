# Neon Postgres connection string (https://console.neon.tech)
DATABASE_URL=

# Better Auth: generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Spotify app credentials (https://developer.spotify.com/dashboard).
# Client Credentials flow, used server-side only for public album data.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
